name: Deploy AI Gateway

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]
    paths:
      - 'server/**'
      - '.github/workflows/deploy-ai-gateway.yml'

permissions:
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Test gateway source
        working-directory: server
        run: npm test

      - name: Check gateway secrets
        id: check
        env:
          CF_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CF_ACCOUNT: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          GEMINI_KEY: ${{ secrets.GEMINI_API_KEY }}
          DEEPSEEK_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
        run: |
          if [ -z "$CF_TOKEN" ] || [ -z "$CF_ACCOUNT" ] || [ -z "$GEMINI_KEY" ] || [ -z "$DEEPSEEK_KEY" ]; then
            echo "ready=false" >> "$GITHUB_OUTPUT"
            echo "Gateway belum dideploy: lengkapi Cloudflare dan provider secrets satu kali di GitHub." 
          else
            echo "ready=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Install Wrangler
        if: steps.check.outputs.ready == 'true'
        run: npm install --global wrangler@4

      - name: Deploy gateway
        if: steps.check.outputs.ready == 'true'
        working-directory: server
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: wrangler deploy --config wrangler.toml

      - name: Upload Gemini server secret
        if: steps.check.outputs.ready == 'true'
        working-directory: server
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: printf '%s' "$GEMINI_API_KEY" | wrangler secret put GEMINI_API_KEY --config wrangler.toml

      - name: Upload DeepSeek server secret
        if: steps.check.outputs.ready == 'true'
        working-directory: server
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
        run: printf '%s' "$DEEPSEEK_API_KEY" | wrangler secret put DEEPSEEK_API_KEY --config wrangler.toml
